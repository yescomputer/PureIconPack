<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:targetApi="25">

    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_search"
        android:shortcutId="shortcut_search"
        android:shortcutLongLabel="@string/shortcut_search"
        android:shortcutShortLabel="@string/shortcut_search">
        <intent
            android:action="dev.iconpack.pure.SHORTCUT_SEARCH"
            android:targetClass="dev.iconpack.pure.MainActivity"
            android:targetPackage="dev.iconpack.pure" />
    </shortcut>

    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_apply"
        android:shortcutId="shortcut_apply"
        android:shortcutLongLabel="@string/quick_apply"
        android:shortcutShortLabel="@string/nav_apply">
        <intent
            android:action="dev.iconpack.pure.SHORTCUT_APPLY"
            android:targetClass="dev.iconpack.pure.MainActivity"
            android:targetPackage="dev.iconpack.pure" />
    </shortcut>
</shortcuts>
