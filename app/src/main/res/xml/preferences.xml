<?xml version="1.0" encoding="utf-8"?>
<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.preference.PreferenceCategory
        android:key="interface_prefs"
        android:title="@string/pref_category_interface"
        app:iconSpaceReserved="false">
        <androidx.preference.ListPreference
            android:defaultValue="system"
            android:entries="@array/theme_entries"
            android:entryValues="@array/theme_values"
            android:key="app_theme"
            android:title="@string/pref_app_theme"
            app:iconSpaceReserved="false"
            app:useSimpleSummaryProvider="true" />
        <androidx.preference.SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="use_amoled"
            android:summary="@string/pref_use_amoled_summary"
            android:title="@string/pref_use_amoled"
            app:iconSpaceReserved="false" />
        <androidx.preference.SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="use_material_you"
            android:summary="@string/pref_use_material_you_summary"
            android:title="@string/pref_use_material_you"
            app:iconSpaceReserved="false" />
    </androidx.preference.PreferenceCategory>

    <androidx.preference.PreferenceCategory
        android:key="data_prefs"
        android:title="@string/pref_category_data"
        app:iconSpaceReserved="false">
        <androidx.preference.Preference
            android:key="clear_data_cache"
            android:title="@string/pref_clear_cache"
            app:iconSpaceReserved="false" />
    </androidx.preference.PreferenceCategory>

    <androidx.preference.PreferenceCategory
        android:key="versions"
        android:title="@string/pref_category_versions"
        app:iconSpaceReserved="false">
        <androidx.preference.Preference
            android:key="app_version"
            android:title="@string/pref_app_version"
            app:iconSpaceReserved="false" />
        <androidx.preference.Preference
            android:key="dashboard_version"
            android:summary="@string/pref_dashboard_version_value"
            android:title="@string/pref_dashboard_version"
            app:iconSpaceReserved="false" />
    </androidx.preference.PreferenceCategory>
</androidx.preference.PreferenceScreen>
